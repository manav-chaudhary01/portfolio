# ==============================================================================
# Portfolio Phase 7: Elsewhere / Live Activity Environment Configuration
# ==============================================================================
# These credentials are consumed exclusively by the server/serverless layer
# (api/activity.ts and server/activityService.js).
#
# NEVER prefix these with VITE_ to prevent bundling secrets into client builds.
# ==============================================================================

# GitHub Activity Integration
# A read-only GitHub Personal Access Token (classic: `read:user` or fine-grained: Public Repositories (read-only))
# Required for fetching the private/public contribution heatmap via GraphQL (api.github.com/graphql).
# If omitted, the service falls back to public events via REST without failing.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=manav-chaudhary01

# LeetCode Activity Integration
# The public LeetCode username whose profile and submission calendar to display.
# Query: https://leetcode.com/graphql
LEETCODE_USERNAME=manav_chaudhary01

# LinkedIn Single Latest Post Integration
# Official LinkedIn Community Management / Member Post API access (requires r_member_social partner permission).
# If omitted or unapproved, the portfolio seamlessly uses src/data/latestLinkedInPost.ts for manual curation
# or renders a refined direct profile connection invitation.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_ID=

# ==============================================================================
# Production Domain / SEO Configuration
# ==============================================================================
# Set this to your actual production domain (e.g., https://manavchaudhary.com or https://portfolio.vercel.app)
# Used during build to generate absolute URLs in sitemap.xml and robots.txt.
# If unset, build generates placeholder-guided absolute sitemaps with configuration instructions.
SITE_URL=
